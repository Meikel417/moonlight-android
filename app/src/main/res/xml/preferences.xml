            android:title="Höhe der virtuellen PC-Tastatur" />

        <CheckBoxPreference
            android:key="checkbox_enable_keyboard_axi_combination"
            android:title="Tastenkombi-Modus der PC-Tastatur"
            android:summary="Mit Haken ist der Tastenkombi-Modus standardmäßig an"
