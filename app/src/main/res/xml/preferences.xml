            android:defaultValue="false"/>

        <CheckBoxPreference
            android:key="checkbox_enable_device_rumble"
            android:title="Vibrationsmotor des Handys erzwingen"
            android:summary="Wenn dir die Vibration deines Controllers nicht gefällt, schalte das ein! [Wirkt nicht mit erzwungenem Moonlight-USB-Treiber]"
            android:defaultValue="false"/>

        <CheckBoxPreference
            android:key="checkbox_enable_virtual_motion"
            android:title="Virtueller Controller nutzt das Handy-Gyro"
            android:summary="Einschalten, wenn der virtuelle Controller Gyro unterstützen soll.\nEvtl. muss in Sunshine der Controller auf PS4 erzwungen werden.\nBei echtem Controller besser ausschalten."
            android:defaultValue="false"/>

        <CheckBoxPreference
            android:key="checkbox_enable_clear_default_special_button"
            android:title="Eingebaute Sondertasten-Befehle (Tastenkürzel) deaktivieren"
            android:summary="Wenn dir die eingebauten Befehle nichts bringen, kannst du sie abschalten und eigene importieren."
            android:defaultValue="false"/>

        <CheckBoxPreference
            android:key="checkbox_enable_game_manager_quest"
            android:title="Spielmodus deaktivieren"
            android:summary="Hilft evtl. bei Quest mit Android 13 und neuer"
            android:defaultValue="false"/>

        <Preference
            android:key="import_switch_button_file"
            android:title="Eigene Bedienungshilfe-Konfiguration importieren"
            android:summary="Überschreibt jedes Mal die alte Datei, bitte vorher sichern."
            />

        <CheckBoxPreference
            android:key="checkbox_enable_accessibility_show_log"
            android:title="Bedienungshilfe-Tastatur zeigt Tastencodes"
            android:summary="Öffnet die Bedienungshilfe-Tastatur: Tastendrücke in der App zeigen den Tastencode an, für eigene Bedienungshilfe-Konfigurationen."
            android:defaultValue="false"/>

    </PreferenceCategory>


    <PreferenceCategory android:title="Virtuelle Tasten"
        android:key="category_axixi_settings">

        <CheckBoxPreference
            android:key="checkbox_enable_keyboard"
            android:title="Virtuelle Tasten anzeigen"
            android:summary="Zeigt eine Ebene mit virtuellen Sondertasten auf dem Touchscreen.\nDie Transparenz teilt sie sich mit dem virtuellen Controller oben."
            android:defaultValue="false"/>

        <ListPreference
            android:key="keyboard_axi_list"
            android:title="Standard-Layout"
            android:summary="Hoch- und Querformat lassen sich getrennt einstellen."
            android:entries="@array/keyboard_axi_names"
            android:entryValues="@array/keyboard_axi_values"
            android:defaultValue="OSC_Keyboard" />

        <CheckBoxPreference
            android:key="checkbox_vibrate_keyboard"
            android:title="@string/title_checkbox_vibrate_osc"
            android:summary="Beim Tippen auf Bildschirmtasten vibriert das Handy, gilt auch für den virtuellen Controller."
            android:defaultValue="false" />

        <Preference
            android:key="import_keyboard_file"
            android:title="Virtuelle Tasten importieren"
            android:summary="Konfigurationsdatei wählen, die das Standard-Layout ersetzt. (Nur Querformat)"
            />

        <Preference
            android:key="export_keyboard_file"
            android:title="Virtuelle Tasten exportieren"
            android:summary="Konfiguration des Standard-Layouts exportieren. (Nur Querformat)"
            />

    </PreferenceCategory>

    <PreferenceCategory android:title="Audio-Vibration (Beta)"
        android:key="category_axixi_audio_rumble">
        <CheckBoxPreference
            android:key="checkbox_enable_audio_haptics"
            android:title="Audio-Vibration aktivieren"
            android:summary="Wandelt Stream-Ton in Vibration um, gut für Explosionen, Treffer und tiefe Töne"
            android:defaultValue="false" />
        <ListPreference
            android:key="list_audio_haptics_output_target"
            android:dependency="checkbox_enable_audio_haptics"
            android:title="Ausgabeziel der Audio-Vibration"
            android:summary="Ausgabe auf das Handy oder auf einen verbundenen Controller"
            android:entries="@array/audio_haptics_output_target_names"
            android:entryValues="@array/audio_haptics_output_target_values"
            android:defaultValue="phone" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_audio_haptics_strength"
            android:dependency="checkbox_enable_audio_haptics"
            android:defaultValue="100"
            seekbar:min="25"
            seekbar:step="5"
            seekbar:keyStep="5"
            android:max="200"
            android:summary="Stärke der Audio-Vibration am Handy oder Controller einstellen."
            android:text="%"
            android:title="Audio-Vibrationsstärke" />
        <ListPreference
            android:key="list_audio_haptics_voice_filter"
            android:dependency="checkbox_enable_audio_haptics"
            android:title="Sprachfilter"
            android:summary="Stimmen, Sprachchat und Ansagen lösen weniger Vibration aus"
            android:entries="@array/audio_haptics_voice_filter_names"
            android:entryValues="@array/audio_haptics_voice_filter_values"
            android:defaultValue="off" />
        <CheckBoxPreference
            android:key="checkbox_audio_haptics_keep_controller_rumble"
            android:dependency="checkbox_enable_audio_haptics"
            android:title="Normale Controller-Vibration behalten"
            android:summary="Bei Ausgabe auf den Controller die originale Spiel-Vibration behalten. Standard: aus."
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pairing_backup_category"
        android:key="category_axixi_back_data">

        <Preference
            android:key="export_pairing_backup"
            android:title="@string/pairing_backup_export"
            android:summary="@string/pairing_backup_export_summary" />

        <Preference
            android:key="import_pairing_backup"
            android:title="@string/pairing_backup_import"
            android:summary="@string/pairing_backup_import_summary" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Startbildschirm-Einstellungen"
        android:key="category_axixi_screen">

        <CheckBoxPreference
            android:key="checkbox_enable_screen_bg"
            android:title="Eigenes Hintergrundbild verwenden"
            android:summary="Ohne Haken wird der Standardhintergrund genutzt, ab Android 10"
            android:defaultValue="false" />

        <Preference
            android:key="import_image_file_key"
            android:title="Hintergrundbild des Startbildschirms"
            android:summary="Bild wählen, gilt nach dem Drehen~\nNicht zu große oder exotische Bilder nehmen, sonst Absturzgefahr~\nNach einem Absturz hilft Daten löschen~"
            />

        <CheckBoxPreference
            android:key="checkbox_enable_screen_obscure"
            android:title="Hintergrund weichzeichnen"
            android:summary="Eigenes Hintergrundbild weichzeichnen, ab Android 12."
            android:defaultValue="true" />

        <EditTextPreference
            android:key="change_screen_label_key"
            android:defaultValue="@string/app_label"
            android:singleLine="true"
            android:dialogTitle="Text links auf dem Startbildschirm"
            android:summary="Gib deinen Lieblingstext ein"
            android:dialogMessage="Gib deinen Lieblingstext ein~"
            android:title="Text links auf dem Startbildschirm" />

        <CheckBoxPreference
            android:key="checkbox_enable_pass_menu"
            android:title="App-Listen-Menü überspringen"
            android:summary="Wenn an, startet ein Tippen auf das Symbol direkt den Stream, ohne Menü."
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Über"
        android:key="category_axi_about">

        <com.limelight.preferences.WebLauncherPreference
            android:key="settings_about"
            android:title="Über uns"
            android:summary="Versionsinfo · Updates · Entwickler folgen"
            url="about"/>

        <com.limelight.preferences.WebLauncherPreference
            android:key="settings_help"
            android:title="Moonlight-Hilfe"
            android:summary="Offizielle Anleitung"
            url="https://github.com/moonlight-stream/moonlight-docs/wiki/Setup-Guide"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_stream_logs"
        android:title="Stream-Log">

        <CheckBoxPreference
            android:key="checkbox_enable_stream_session_logging"
            android:title="Stream-Logs aufzeichnen"
            android:summary="Erstellt pro Stream ein neues Log zu Verbindung, Bild, Netzwerk, Controller und Abbrüchen; standardmäßig aus"
            android:defaultValue="false" />

        <Preference
            android:key="manage_stream_session_logs"
            android:title="Log-Liste"
            android:summary="Gespeicherte Stream-Logs ansehen, exportieren oder löschen" />

    </PreferenceCategory>


    <!-- Additional persistent controls also available through the in-stream quick menu. -->
    <PreferenceCategory android:key="category_settings_additional" android:title="Weitere Einstellungen">
        <CheckBoxPreference
            android:key="checkbox_enable_hdr_high_brightness"
            android:title="HDR hohe Helligkeit"
            android:summary="Erhöht die HDR-Helligkeit auf unterstützten Geräten"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_enforce_display_mode"
            android:title="Anzeigemodus erzwingen"
            android:summary="Bevorzugt einen Anzeigemodus passend zur Stream-FPS; bei Anzeigeproblemen ausschalten"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_keep_video_zoom_on_disable"
            android:title="Bildzoom beibehalten"
            android:summary="Beim Beenden der Zoom-Einstellung den angepassten Ausschnitt behalten"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_keyboard_esc_opens_game_menu"
            android:title="Esc öffnet das Spielmenü"
            android:summary="Esc auf der physischen Tastatur öffnet das Stream-Schnellmenü"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_ds5_native_pcm"
            android:title="Native DualSense-Audio-Vibration"
            android:summary="Native PCM-Haptikdaten von unterstützten Hosts empfangen"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="checkbox_ds5_controller_speaker"
            android:title="DualSense-Controller-Lautsprecher"
            android:summary="Spiel-Ton über den Lautsprecher unterstützter DualSense-Controller ausgeben"
            android:defaultValue="false" />
    </PreferenceCategory>

