    <PreferenceCategory android:title="Startbildschirm-Einstellungen"
        android:key="category_axixi_settings">

        <EditTextPreference
            android:key="edit_diy_w_h"
            android:defaultValue="1920x1080"
            android:singleLine="true"
            android:dialogTitle="Nach dem Einstellen der Auflösung Einstellungen verlassen und neu öffnen!"
            android:summary="Eigene Auflösung hinzufügen, mit x getrennt; ungewöhnliche Auflösungen funktionieren evtl. nicht.\nBeispiel: 1920x1080\nBei Notch-Displays wird der Notch-Bereich mit nicht-nativen Auflösungen evtl. nicht ausgefüllt.\nBei gleichem Seitenverhältnis kannst du das Bild manuell strecken."
            android:title="Eigene Auflösung" />

        <CheckBoxPreference
            android:key="checkbox_enable_portrait"
            android:title="Hochformat-Modus"
            android:summary="Zusammen mit eigener Auflösung; der Host muss das unterstützen und die PC-Auflösung muss hochkant sein"
            android:defaultValue="false"/>

        <CheckBoxPreference
            android:key="checkbox_enable_joyconfix"
            android:title="Switch-JoyCon-Unterstützung"
            android:summary="Wenn deine JoyCons nicht gehen oder Tasten falsch erkannt werden, probier das. Ab Android 10"
            android:defaultValue="false"/>

        <CheckBoxPreference
            android:key="checkbox_gamepad_enable_battery_report"
            android:summary="Meldet den Controller-Akkustand, wenn möglich.\nWenn Touch, Touchpad, Stift oder Maus gelegentlich ruckeln, kann Ausschalten helfen."
            android:title="Controller-Akkustand melden"
            android:defaultValue="true"
            />

        <CheckBoxPreference
            android:key="checkbox_enable_ax_floating"
            android:title="Schwebenden Knopf aktivieren"
            android:summary="Wenn an, öffnet ein Tippen das Schnellmenü."
            android:defaultValue="true"/>

        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_keyboard_axi_opacity"
            seekbar:min="0"
            seekbar:step="1"
            android:max="100"
            android:defaultValue="90"
            android:summary="@string/summary_osc_opacity"
            android:text="%"
            android:title="Transparenz der virtuellen PC-Tastatur" />

        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_keyboard_axi_height"
            seekbar:min="150"
            seekbar:step="10"
            android:max="400"
            android:defaultValue="200"
            android:summary="Höhe der virtuellen PC-Tastatur einstellen"
