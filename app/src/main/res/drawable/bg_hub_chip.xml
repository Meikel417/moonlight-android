<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hub_flaeche_hell" />
            <corners android:radius="100dp" />
            <stroke android:width="1dp" android:color="@color/hub_akzent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hub_flaeche" />
            <corners android:radius="100dp" />
            <stroke android:width="1dp" android:color="@color/hub_rand" />
        </shape>
    </item>
</selector>
