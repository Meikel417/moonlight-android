<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hub_hintergrund"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Kopf: Titel und Weg zur normalen Moonlight-Ansicht -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hubTitel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hub_titel"
            android:textColor="@color/hub_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hubUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_hub_kachel_aktiv"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/hub_update_chip"
            android:textColor="@color/hub_akzent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hubMoonlightAnsicht"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hub_chip"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/hub_moonlight_ansicht"
            android:textColor="@color/hub_akzent"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Statuszeile -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hubChipTailscale"
                style="@style/HubChip"
                android:text="@string/hub_tailscale_aus" />

            <TextView
                android:id="@+id/hubChipWlan"
                style="@style/HubChip"
                android:layout_marginStart="8dp"
                android:text="@string/hub_wlan_unbekannt" />

            <TextView
                android:id="@+id/hubChipPc"
                style="@style/HubChip"
                android:layout_marginStart="8dp"
                android:text="@string/hub_pc_keiner" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Letzte Nachrichten (kommt mit der Sprachfunktion) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_hub_kachel"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hub_letzte_nachrichten"
            android:textColor="@color/hub_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hub_letzte_nachrichten_leer"
            android:textColor="@color/hub_text_gedimmt"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Kacheln unten -->
    <LinearLayout
        android:id="@+id/hubKacheln"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
